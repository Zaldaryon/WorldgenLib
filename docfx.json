{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "WorldgenLib",
          "files": [
            "WorldgenLib.VintageStory.csproj"
          ]
        }
      ],
      "dest": "_api",
      "filter": "docfx-filter.yml",
      "noRestore": true,
      "properties": {
        "Configuration": "Release",
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "template": [
      "default",
      "modern"
    ],
    "content": [
      {
        "src": "docs/api",
        "files": [
          "index.md"
        ],
        "dest": "api"
      },
      {
        "src": "docs/api",
        "files": [
          "**/*.md"
        ],
        "exclude": [
          "index.md"
        ],
        "dest": "guide"
      },
      {
        "src": "_api",
        "files": [
          "**/*.yml"
        ],
        "dest": "api"
      }
    ],
    "globalMetadata": {
      "_appTitle": "WorldgenLib API Reference",
      "_appName": "WorldgenLib",
      "_appFooter": "WorldgenLib",
      "_enableSearch": "true",
      "_gitUrlPattern": "github"
    },
    "output": "_site"
  }
}
